<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WaterTracker.ViewModels"
             xmlns:models="clr-namespace:WaterTracker.Models"
             mc:Ignorable="d"
             x:Class="WaterTracker.Views.MainView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>

        <Style Selector="Path#DropWavePath">
            <Style.Animations>

                <Animation Duration="0:0:1"
                           IterationCount="Infinite">

                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X"
                                Value="0"/>
                    </KeyFrame>

                    <KeyFrame Cue="50%">
                        <Setter Property="TranslateTransform.X"
                                Value="-10"/>
                    </KeyFrame>

                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X"
                                Value="0"/>
                    </KeyFrame>

                </Animation>

            </Style.Animations>
        </Style>

    </UserControl.Styles>


    <Border Background="#FFF1F5">

        <ScrollViewer>

            <StackPanel Width="500"
                        HorizontalAlignment="Center"
                        Margin="25">


                <TextBlock Text="♡ WaterTracker ♡"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#E85D7F"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,25"/>


                <Border Background="White"
                        CornerRadius="30"
                        Padding="25">

                    <StackPanel>


                        <Grid Width="300"
                              Height="380"
                              HorizontalAlignment="Center">

                            <Image Source="/Assets/hello-kitty-drop.png"
                                   Width="300"
                                   Height="380"
                                   Stretch="Uniform"/>
                            
                            <Grid Width="65"
                                  Height="95"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Margin="30,165,0,0">

                                <Grid.Clip>
                                    <PathGeometry Figures="
                                                            M47,0
                                                            C39,13 9,52 5,82
                                                            C2,108 18,132 47,132
                                                            C76,132 92,108 89,82
                                                            C85,52 55,13 47,0
                                                            Z"/>
                                </Grid.Clip>

                                <Grid VerticalAlignment="Bottom"
                                      Height="{Binding DropWaterHeight}">

                                    <Border Background="#12C3E5"/>

                                    <Path x:Name="DropWavePath"
                                          Fill="#12C3E5"
                                          Height="16"
                                          VerticalAlignment="Top"
                                          Stretch="Fill"
                                          Data="
                                                M 0,8
                                                Q 24,0 47,8
                                                Q 71,16 95,8
                                                L 95,20
                                                L 0,20 Z">

                                        <Path.RenderTransform>
                                            <TranslateTransform X="0"/>
                                        </Path.RenderTransform>

                                    </Path>

                                </Grid>

                            </Grid>
                        </Grid>

                        <TextBlock Text="{Binding WaterStatus}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#E85D7F"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>


                        <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:0}%'}"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"/>
                        
                        <Border IsVisible="{Binding GoalReached}"
                                Background="#FFE0E8"
                                CornerRadius="18"
                                Padding="15"
                                Margin="0,15,0,0"
                                HorizontalAlignment="Center">

                            <StackPanel>

                                <TextBlock Text="🎀 Tagesziel erreicht! 🎀"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#E85D7F"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Du hast heute genug Wasser getrunken!"
                                           FontSize="13"
                                           Foreground="#A85C70"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>

                            </StackPanel>

                        </Border>


                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="10"
                                    Margin="0,20,0,0">


                            <Button Content="+250 ml"
                                    Command="{Binding AddWater250Command}"
                                    Background="#FF9EB5"
                                    Foreground="White"
                                    CornerRadius="18"
                                    Width="90"
                                    Height="45"/>


                            <Button Content="+500 ml"
                                    Command="{Binding AddWater500Command}"
                                    Background="#FF9EB5"
                                    Foreground="White"
                                    CornerRadius="18"
                                    Width="90"
                                    Height="45"/>


                            <Button Content="Reset"
                                    Command="{Binding ResetWaterCommand}"
                                    Background="White"
                                    Foreground="#E85D7F"
                                    CornerRadius="18"
                                    Width="70"
                                    Height="45"/>


                        </StackPanel>


                    </StackPanel>

                </Border>


                <Border Background="#FFE0E8"
                        CornerRadius="20"
                        Padding="20"
                        Margin="0,20,0,0">

                    <StackPanel>


                        <TextBlock Text="♡ Tagesziel"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#E85D7F"/>


                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    Margin="0,12,0,0">


                            <NumericUpDown Value="{Binding DailyGoal}"
                                           Minimum="250"
                                           Maximum="10000"
                                           Increment="250"
                                           Width="150"/>


                            <Button Content="Speichern"
                                    Command="{Binding SaveDailyGoalCommand}"
                                    Background="#FF9EB5"
                                    Foreground="White"
                                    CornerRadius="15"/>


                        </StackPanel>


                    </StackPanel>

                </Border>


                <Border Background="White"
                        CornerRadius="20"
                        Padding="20"
                        Margin="0,20,0,0">

                    <StackPanel>


                        <TextBlock Text="♡ Heute getrunken"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#E85D7F"
                                   Margin="0,0,0,10"/>


                        <ItemsControl ItemsSource="{Binding DrinkEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WaterEntry"
                                              x:CompileBindings="False">

                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                          Margin="0,6">

                                        <TextBlock Text="{Binding AmountText}"
                                                   Foreground="#E85D7F"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TimeText}"
                                                   Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#777777"/>

                                        <Button Grid.Column="2"
                                                Content="✕"
                                                CommandParameter="{Binding}"
                                                Command="{Binding $parent[ItemsControl].DataContext.DeleteEntryCommand}"
                                                Background="#FFE0E8"
                                                Foreground="#E85D7F"
                                                CornerRadius="10"
                                                Width="32"
                                                Height="32"/>

                                    </Grid>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>


                    </StackPanel>

                </Border>


                <Border Background="#FFE0E8"
                        CornerRadius="20"
                        Padding="20"
                        Margin="0,20,0,30">

                    <StackPanel>


                        <TextBlock Text="♡ Vergangene Tage"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#E85D7F"
                                   Margin="0,0,0,10"/>


                        <ItemsControl ItemsSource="{Binding DailyHistories}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate x:DataType="models:DailyHistory">

                                    <Border Background="White"
                                            CornerRadius="15"
                                            Padding="12"
                                            Margin="0,5">

                                        <Grid ColumnDefinitions="*,Auto">

                                            <StackPanel>

                                                <TextBlock Text="{Binding DateText}"
                                                           FontWeight="Bold"
                                                           Foreground="#444444"/>

                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="13"
                                                           Foreground="#888888"/>

                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">

                                                <Border IsVisible="{Binding GoalReached}"
                                                        Background="#FFD6E2"
                                                        CornerRadius="12"
                                                        Padding="10,5">

                                                    <TextBlock Text="🎀 Ziel erreicht"
                                                               Foreground="#E85D7F"
                                                               FontWeight="Bold"/>

                                                </Border>

                                                <TextBlock IsVisible="{Binding GoalNotReached}"
                                                           Text="Noch nicht erreicht"
                                                           Foreground="#999999"
                                                           VerticalAlignment="Center"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>


                    </StackPanel>

                </Border>


            </StackPanel>

        </ScrollViewer>

    </Border>

</UserControl>